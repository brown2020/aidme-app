{
  "name": "aidme-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:ci": "CI=true vitest run",
    "test:rules": "npx -y firebase-tools@15.34.2 emulators:exec --only firestore --project demo-aidme \"vitest run --config vitest.rules.config.mts\"",
    "test:e2e": "npx -y firebase-tools@15.34.2 emulators:exec --only auth,firestore --project demo-aidme \"playwright test\"; status=$?; rm -rf .next-e2e; exit $status",
    "deploy:rules": "npx -y firebase-tools@15.34.2 deploy --only firestore:rules,firestore:indexes --project aidmehearing",
    "typecheck": "tsc --noEmit",
    "doctor": "npx -y react-doctor@0.9.22 . --scope full --yes --no-cache"
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "lucide-react": "^1.68.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/compat": "^2.1.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "minimatch": "^11.0.4",
    "postcss": "$postcss"
  }
}
