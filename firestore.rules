rules_version = '2';

// Live shared transcripts.
// sessions/{sessionId}: owned by one user; invitees are stored only as
//   SHA-256 fingerprints of their email (viewerKeys).
// sessions/{sessionId}/private/invites: the invited emails, owner-only.
// sessions/{sessionId}/lines/{lineId}: append-only finished sentences.
// sessions/{sessionId}/interim/{slot}: words still being spoken, rotated
//   across four documents to stay under per-document write limits.
//
// Field lists must match src/lib/liveSessionModel.ts (see firestoreSchema.test.ts).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasVerifiedEmail() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    // Must match emailKey() in liveSessionModel.ts.
    function viewerKey() {
      return hashing.sha256(myEmail()).toHexString().lower();
    }

    function isOwner(data) {
      return signedIn() && data.ownerUid == request.auth.uid;
    }

    // Unverified accounts could claim any address, so viewers must be verified.
    function isViewer(data) {
      return hasVerifiedEmail() && viewerKey() in data.viewerKeys;
    }

    function sessionKeys() {
      return ['ownerUid', 'ownerName', 'ownerEmail', 'title', 'status',
              'language', 'viewerKeys', 'createdAt', 'updatedAt'];
    }

    function validSession(d) {
      return d.keys().hasOnly(sessionKeys())
        && d.keys().hasAll(sessionKeys())
        && d.ownerName is string && d.ownerName.size() > 0 && d.ownerName.size() <= 100
        && d.title is string && d.title.size() <= 120
        && d.status in ['live', 'ended']
        && d.language is string && d.language.size() <= 20
        && d.viewerKeys is list && d.viewerKeys.size() <= 10
        && d.updatedAt == request.time;
    }

    match /sessions/{sessionId} {
      allow get, list: if isOwner(resource.data) || isViewer(resource.data);

      allow create: if hasVerifiedEmail()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail == myEmail()
        && request.resource.data.status == 'live'
        && request.resource.data.createdAt == request.time
        && validSession(request.resource.data);

      allow update: if isOwner(resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && request.resource.data.ownerName == resource.data.ownerName
        && request.resource.data.createdAt == resource.data.createdAt
        && validSession(request.resource.data);

      // A viewer may remove only their own fingerprint (leaving, or deleting their account).
      allow update: if isViewer(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewerKeys', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.viewerKeys.toSet()
             == resource.data.viewerKeys.toSet().difference([viewerKey()].toSet());

      allow delete: if isOwner(resource.data);

      function session() {
        return get(/databases/$(database)/documents/sessions/$(sessionId)).data;
      }

      // Lets the invites document be written in the same batch that creates the session.
      function sessionAfter() {
        return getAfter(/databases/$(database)/documents/sessions/$(sessionId)).data;
      }

      match /private/{docId} {
        allow read: if isOwner(session());

        allow create, update: if docId == 'invites'
          && isOwner(sessionAfter())
          && request.resource.data.keys().hasOnly(['emails', 'updatedAt'])
          && request.resource.data.keys().hasAll(['emails', 'updatedAt'])
          && request.resource.data.emails is list
          && request.resource.data.emails.size() <= 10
          && request.resource.data.updatedAt == request.time;

        allow delete: if isOwner(session());
      }

      match /interim/{slot} {
        allow read: if isOwner(session()) || isViewer(session());

        allow create, update: if slot in ['0', '1', '2', '3']
          && isOwner(session())
          && session().status == 'live'
          && request.resource.data.keys().hasOnly(['text', 'seq', 'updatedAt'])
          && request.resource.data.keys().hasAll(['text', 'seq', 'updatedAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && request.resource.data.seq is int
          && request.resource.data.seq >= 0
          && request.resource.data.updatedAt == request.time;

        allow delete: if isOwner(session());
      }

      match /lines/{lineId} {
        allow read: if isOwner(session()) || isViewer(session());

        allow create: if isOwner(session())
          && session().status == 'live'
          && request.resource.data.keys().hasOnly(['text', 'createdAt'])
          && request.resource.data.keys().hasAll(['text', 'createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;

        allow update: if false;
        allow delete: if isOwner(session());
      }
    }
  }
}
